#!/usr/bin/env bash
# Ensure README.md and README.zh-CN.md stay in sync when shared/ top-level
# structure changes (new tool added or whole tool dir removed).
#
# Bypass with: git commit --no-verify

set -e

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"

# Only run inside the supported dotfiles clone path; pass through elsewhere.
case "$repo_root" in
    "$HOME/dotfiles") ;;
    *) exit 0 ;;
esac

added="$(git diff --cached --name-only --diff-filter=A  | grep '^shared/[^/]\+/' || true)"
deleted="$(git diff --cached --name-only --diff-filter=D | grep '^shared/[^/]\+/' || true)"
staged_all="$(git diff --cached --name-only)"

new_dirs=""
removed_dirs=""

# New top-level dirs: a staged add path's top-level dir didn't exist in HEAD.
while IFS= read -r path; do
    [ -z "$path" ] && continue
    top="$(printf '%s' "$path" | cut -d/ -f1-2)"
    case " $new_dirs " in *" $top "*) continue ;; esac
    if ! git ls-tree -d --name-only HEAD -- "$top" >/dev/null 2>&1 \
       || [ -z "$(git ls-tree -d --name-only HEAD -- "$top" 2>/dev/null)" ]; then
        new_dirs="$new_dirs $top"
    fi
done <<EOF
$added
EOF

# Removed top-level dirs: after applying staged deletes, no tracked file remains under that top.
while IFS= read -r path; do
    [ -z "$path" ] && continue
    top="$(printf '%s' "$path" | cut -d/ -f1-2)"
    case " $removed_dirs " in *" $top "*) continue ;; esac
    # Files still tracked under $top, minus the ones being deleted in this commit
    remaining="$(git ls-files -- "$top" | grep -vxFf <(printf '%s\n' "$deleted") || true)"
    if [ -z "$remaining" ]; then
        removed_dirs="$removed_dirs $top"
    fi
done <<EOF
$deleted
EOF

new_dirs="$(printf '%s' "$new_dirs"     | sed 's/^ //')"
removed_dirs="$(printf '%s' "$removed_dirs" | sed 's/^ //')"

if [ -n "$new_dirs" ] || [ -n "$removed_dirs" ]; then
    missing_readmes=""
    if ! printf '%s\n' "$staged_all" | grep -q '^README\.md$'; then
        missing_readmes="$missing_readmes README.md"
    fi
    if ! printf '%s\n' "$staged_all" | grep -q '^README\.zh-CN\.md$'; then
        missing_readmes="$missing_readmes README.zh-CN.md"
    fi

    if [ -n "$missing_readmes" ]; then
        cat >&2 <<MSG
✗ pre-commit: shared/ top-level structure changed but README files are not both staged.

  Added tool dirs:   ${new_dirs:-(none)}
  Removed tool dirs: ${removed_dirs:-(none)}
  Missing staged:    ${missing_readmes# }

  Update BOTH:
    - README.md          ("Layout" tree + "What's tracked" table + hard rules)
    - README.zh-CN.md    (mirror the same changes)

  Then re-stage and commit again.

  Escape hatch (use intentionally): git commit --no-verify
MSG
        exit 1
    fi
fi

exit 0
